# Copy to .env.local and fill in your own values.
# .env.local is gitignored, so each machine and each deploy supplies its own copy.

# Supabase project URL and publishable (anon) key.
# Dashboard → Project Settings → API.
#
# The URL must be the bare project origin — exactly as shown in the dashboard,
# with no trailing slash and no /rest/v1 path. supabase-js appends "rest/v1" and
# the auth path itself; supplying them here doubles the path and every request
# fails with "Invalid path specified in request URL".
VITE_SUPABASE_URL=https://yqvwzzubvztubcyzyuig.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_WHuDG8zj3oqBQZWE7SCKXA_xwUR7oMR